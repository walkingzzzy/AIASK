# ── AIASK 环境变量配置模板 ──
# 复制为 .env 后修改

# PostgreSQL / TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockdb
POSTGRES_PORT=5432
POSTGRES_CONTAINER_MEM_LIMIT=4g
POSTGRES_CONTAINER_SHM_SIZE=2gb
POSTGRES_CONTAINER_CPUS=2.0
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1024MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_AUTOVACUUM_WORK_MEM=64MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=1
POSTGRES_MAX_PARALLEL_WORKERS=2
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=1
POSTGRES_MAX_WORKER_PROCESSES=8
POSTGRES_TIMESCALE_MAX_BACKGROUND_WORKERS=4
POSTGRES_HUGE_PAGES=off

# Redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:redis_secret@127.0.0.1:6379

# MCP Server
MCP_PORT=3100
# 推荐：常驻 streamable-http MCP，避免 BFF 按请求拉起/回收 stdio worker 造成按钮慢响应。
MCP_TRANSPORT=streamable-http
MCP_STREAMABLE_HTTP_URL=http://127.0.0.1:3100/mcp
MCP_STREAMABLE_HTTP_HEADERS={"authorization":"Bearer change_me_mcp_token"}
MCP_STREAMABLE_HTTP_ALLOW_SSE_FALLBACK=false
MCP_TRANSPORT_ALLOW_STDIO_FALLBACK=false
AKSHARE_MCP_STARTUP_PROFILE=worker
# Docker 内 MCP 需要绑定 0.0.0.0；compose 只发布到宿主机 127.0.0.1:3100。
MCP_CONTAINER_HOST=0.0.0.0
MCP_CONTAINER_BIND_ALL=true
MCP_HOST=127.0.0.1
MCP_PUBLIC_HOST=127.0.0.1
MCP_ALLOWED_HOSTS=127.0.0.1:3100,localhost:3100,akshare-mcp:3100
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MCP_AUTH_MODE=bearer
MCP_AUTH_TOKEN=change_me_mcp_token
MCP_ALLOW_TOKEN_PASSTHROUGH=false
MCP_POOL_SIZE=4
MCP_STREAMABLE_HTTP_TIMEOUT_MS=2500
MCP_POOL_ACQUIRE_TIMEOUT_MS=1500
BFF_HEALTH_PROBE_TIMEOUT_MS=1500
AKSHARE_MCP_DB_POOL_MIN=1
AKSHARE_MCP_DB_POOL_MAX=2
MCP_STDIO_STARTUP_PROFILE=worker
MARKET_SCHEDULER_ENABLED=true
MARKET_QUOTE_PUSH_INTERVAL_MS=2000
MARKET_INDEX_PUSH_INTERVAL_MS=5000
MARKET_INDEX_FAILURE_BACKOFF_MS=30000
MARKET_INDEX_FAILURE_MAX_BACKOFF_MS=120000

# BFF Server
BFF_PORT=3001
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aiask-bff
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
APP_JWT_SECRET=change_me_in_production
APP_ENCRYPT_SECRET=change_me_in_production_32_chars

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_BFF_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Monitoring
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
OTEL_HEALTH_PORT=13133
POSTGRES_EXPORTER_PORT=9187
BLACKBOX_EXPORTER_PORT=9115

# Sentry (可选)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# 日志级别
LOG_LEVEL=info

# Embedding 默认值
STRATEGY_EMBEDDING_ENABLED=1
STRATEGY_EMBEDDING_PROVIDER=hash_fallback
STRATEGY_EMBEDDING_BASE_URL=
STRATEGY_EMBEDDING_API_KEY=
STRATEGY_EMBEDDING_MODEL=text-embedding-3-small
STRATEGY_EMBEDDING_ALLOW_HASH_FALLBACK=1
STARTUP_EMBEDDING_CHECK_ENABLED=0
VECTOR_INDEX_BUILD_MAINTENANCE_WORK_MEM=256MB
VECTOR_INDEX_BUILD_MAX_PARALLEL_MAINTENANCE_WORKERS=1

# Strategy Factory
FACTOR_SCHEDULER_LLM_MINING=1
STRATEGY_FACTORY_SCHEDULE_MODE=continuous
STRATEGY_FACTORY_MAX_RESEARCH_TASKS=12
STRATEGY_FACTORY_MAX_BULK_RESEARCH_TASKS=20
STRATEGY_FACTORY_CANDIDATES_PER_TASK=4
STRATEGY_FACTORY_TASK_HARD_CAP=24
STRATEGY_FACTORY_RESEARCH_TASK_CONCURRENCY=5
STRATEGY_FACTORY_PRE_GATE_ENABLED=true
STRATEGY_FACTORY_SPAWNER_TARGET_TOTAL=20
STRATEGY_FACTORY_SPAWNER_FILL_BUDGET_MAX=10
STRATEGY_FACTORY_SPAWNER_EVENT_FILL_BUDGET_MAX=3
STRATEGY_FACTORY_SPAWNER_EVENT_SOURCE_BASE_CAP=1
STRATEGY_FACTORY_SPAWNER_EVENT_SOURCE_SUPPLEMENTAL_BONUS=1
STRATEGY_FACTORY_BULK_STOCK_MATRIX_ENABLED=false
STRATEGY_FACTORY_BULK_STOCK_MATRIX_UNIVERSE_LIMIT=5000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_FAMILIES_PER_STOCK=3
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_TASKS_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_CANDIDATES_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_GENERATION_LIMIT_PER_TASK=1
STRATEGY_FACTORY_BULK_BATCH_SIZE=100
STRATEGY_FACTORY_BULK_CONCURRENCY=20
STRATEGY_FACTORY_BULK_STOCK_MATRIX_TASKS_PER_SHARD=24
STRATEGY_FACTORY_FACTOR_AUTO_REFRESH=0
