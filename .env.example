# ── AIASK 环境变量配置模板 ──
# 复制为 .env 后修改

# PostgreSQL / TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockdb
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:redis_secret@127.0.0.1:6379

# MCP Server
MCP_PORT=3100

# BFF Server
BFF_PORT=3001
APP_JWT_SECRET=change_me_in_production
APP_ENCRYPT_SECRET=change_me_in_production_32_chars

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_BFF_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Sentry (可选)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# 日志级别
LOG_LEVEL=info

# Embedding 默认值
STRATEGY_EMBEDDING_ENABLED=1
STRATEGY_EMBEDDING_PROVIDER=hash_fallback
STRATEGY_EMBEDDING_BASE_URL=
STRATEGY_EMBEDDING_API_KEY=
STRATEGY_EMBEDDING_MODEL=text-embedding-3-small
STRATEGY_EMBEDDING_ALLOW_HASH_FALLBACK=1
STARTUP_EMBEDDING_CHECK_ENABLED=0

# Strategy Factory
FACTOR_SCHEDULER_LLM_MINING=1
STRATEGY_FACTORY_SCHEDULE_MODE=continuous
STRATEGY_FACTORY_MAX_RESEARCH_TASKS=12
STRATEGY_FACTORY_MAX_BULK_RESEARCH_TASKS=20
STRATEGY_FACTORY_CANDIDATES_PER_TASK=4
STRATEGY_FACTORY_TASK_HARD_CAP=24
STRATEGY_FACTORY_RESEARCH_TASK_CONCURRENCY=5
STRATEGY_FACTORY_PRE_GATE_ENABLED=true
STRATEGY_FACTORY_SPAWNER_TARGET_TOTAL=20
STRATEGY_FACTORY_SPAWNER_FILL_BUDGET_MAX=10
STRATEGY_FACTORY_SPAWNER_EVENT_FILL_BUDGET_MAX=3
STRATEGY_FACTORY_SPAWNER_EVENT_SOURCE_BASE_CAP=1
STRATEGY_FACTORY_SPAWNER_EVENT_SOURCE_SUPPLEMENTAL_BONUS=1
STRATEGY_FACTORY_BULK_STOCK_MATRIX_ENABLED=false
STRATEGY_FACTORY_BULK_STOCK_MATRIX_UNIVERSE_LIMIT=5000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_FAMILIES_PER_STOCK=3
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_TASKS_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_CANDIDATES_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_GENERATION_LIMIT_PER_TASK=1
STRATEGY_FACTORY_BULK_BATCH_SIZE=100
STRATEGY_FACTORY_BULK_CONCURRENCY=20
STRATEGY_FACTORY_BULK_STOCK_MATRIX_TASKS_PER_SHARD=24
STRATEGY_FACTORY_FACTOR_AUTO_REFRESH=0
