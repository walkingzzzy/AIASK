# ── AIASK 环境变量配置模板 ──
# 复制为 .env 后修改

# SQLite
AIASK_SQLITE_PATH=~/.aiask/akshare_mcp.sqlite3
AKSHARE_MCP_SQLITE_PATH=~/.aiask/akshare_mcp.sqlite3
SQLITE_BUSY_TIMEOUT_MS=30000
SQLITE_JOURNAL_MODE=WAL

# ── 通达信（TDX）本地数据源 ──────────────────────────────────────
# 全局原则：所有数据获取首选"本地通达信 vipdoc"，其次在线行情服务器；
# 如需禁用一切外部源（Tushare/AKShare 等），把 TDX_LOCAL_ONLY=1。
TDX_INSTALL_DIR=C:\new_tdx_test
# tqcenter.py 所在目录（默认 ${TDX_INSTALL_DIR}\PYPlugins\sys）
TDX_PYPLUGINS_PATH=
TDX_DATA_SOURCE=local_first
TDX_LOCAL_ONLY=1
TDX_KLINE_FAVOR_LOCAL=1
# 1 = 客户端不可用直接 raise；0 (默认) = 自动降级 vipdoc/pytdx
TDX_TQCENTER_REQUIRED=0
# tqcenter download_file 落地目录（默认 ${TDX_INSTALL_DIR}\PYPlugins\data）
TDX_DOWNLOAD_DIR=C:\new_tdx_test\PYPlugins\data
TDX_SERVER_IP=119.147.212.81
TDX_SERVER_PORT=7709
# 行情服务器池（覆盖默认 12 个备选，逗号分隔 ip:port）
# TDX_SERVER_POOL=119.147.212.81:7709,180.153.18.170:7709
TDX_CONNECT_TIMEOUT_MS=4000
# 因子计算等只读路径强制本地命中（同 FACTOR_KLINE_LOCAL_ONLY 联动使用）
FACTOR_KLINE_LOCAL_ONLY=1
# 是否保留 Tushare/AKShare/eFinance/Baostock 作为最终兜底 (默认 0=不保留)
DATA_SOURCE_KEEP_LEGACY_FALLBACK=0
AKSHARE_MCP_DATA_ACCESS_POLICY=db_first
AKSHARE_MCP_QUOTE_MAX_STALE_SECONDS=30
AKSHARE_MCP_REALTIME_FALLBACK=1
AKSHARE_MCP_ANALYTICS_LIVE_FALLBACK=0
# 通达信"专业财务数据"是付费功能。默认 0 = 跳过 sync_financial_pro 任务，
# 财务数据走 sync_basic_financial（用 get_stock_info 拿基础财务）。购买并
# 下载专业财务包后再设为 1 启用 FN 字段同步。
TDX_SYNC_ENABLE_PRO_FIN=0

# MCP Server
MCP_PORT=3100
# 如需 direct MCP probe，请把 MCP_TRANSPORT 切到 streamable-http 或 sse
# MCP_TRANSPORT=streamable-http

# AIASK Agent Server
AIASK_AGENT_HOST=127.0.0.1
AIASK_AGENT_PORT=8767
AIASK_AGENT_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
# 非 loopback 绑定时必须配置 API token；本机默认不需要。
AIASK_AGENT_API_TOKEN=
# confirm/deny 控制面必须配置 control token。
AIASK_AGENT_CONTROL_TOKEN=change_me_for_local_control
AIASK_AGENT_MODEL=gpt-4.1-mini
AIASK_AGENT_MAX_ITERATIONS=8
AIASK_AGENT_MODEL_TIMEOUT=120
AIASK_AGENT_TOOL_TIMEOUT=120
AIASK_AGENT_HTTP_LOGS=0

# Observability
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aiask-agent
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Monitoring
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
OTEL_HEALTH_PORT=13133
BLACKBOX_EXPORTER_PORT=9115

# Sentry (可选)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# 日志级别
LOG_LEVEL=info

# Embedding 默认值
STRATEGY_EMBEDDING_ENABLED=1
STRATEGY_EMBEDDING_PROVIDER=hash_fallback
STRATEGY_EMBEDDING_BASE_URL=
STRATEGY_EMBEDDING_API_KEY=
STRATEGY_EMBEDDING_MODEL=text-embedding-3-small
STRATEGY_EMBEDDING_ALLOW_HASH_FALLBACK=1
STARTUP_EMBEDDING_CHECK_ENABLED=0
VECTOR_INDEX_BUILD_MAINTENANCE_WORK_MEM=256MB
VECTOR_INDEX_BUILD_MAX_PARALLEL_MAINTENANCE_WORKERS=1

# Strategy Factory
FACTOR_SCHEDULER_LLM_MINING=1
STRATEGY_FACTORY_SCHEDULE_MODE=continuous
STRATEGY_FACTORY_MAX_RESEARCH_TASKS=12
STRATEGY_FACTORY_MAX_BULK_RESEARCH_TASKS=20
STRATEGY_FACTORY_CANDIDATES_PER_TASK=4
STRATEGY_FACTORY_TASK_HARD_CAP=24
STRATEGY_FACTORY_RESEARCH_TASK_CONCURRENCY=5
STRATEGY_FACTORY_PRE_GATE_ENABLED=true
STRATEGY_FACTORY_SPAWNER_TARGET_TOTAL=20
STRATEGY_FACTORY_SPAWNER_FILL_BUDGET_MAX=10
STRATEGY_FACTORY_SPAWNER_EVENT_FILL_BUDGET_MAX=3
STRATEGY_FACTORY_SPAWNER_EVENT_SOURCE_BASE_CAP=1
STRATEGY_FACTORY_SPAWNER_EVENT_SOURCE_SUPPLEMENTAL_BONUS=1
STRATEGY_FACTORY_BULK_STOCK_MATRIX_ENABLED=false
STRATEGY_FACTORY_BULK_STOCK_MATRIX_UNIVERSE_LIMIT=5000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_FAMILIES_PER_STOCK=3
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_TASKS_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_CANDIDATES_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_GENERATION_LIMIT_PER_TASK=1
STRATEGY_FACTORY_BULK_BATCH_SIZE=100
STRATEGY_FACTORY_BULK_CONCURRENCY=20
STRATEGY_FACTORY_BULK_STOCK_MATRIX_TASKS_PER_SHARD=24
STRATEGY_FACTORY_FACTOR_AUTO_REFRESH=0
