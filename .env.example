# ── AIASK 环境变量配置模板 ──
# 复制为 .env 后修改

# PostgreSQL / TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockdb
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# MCP Server
MCP_PORT=3100

# BFF Server
BFF_PORT=4000
JWT_SECRET=change_me_in_production

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_BFF_URL=http://localhost:4000

# Sentry (可选)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# 日志级别
LOG_LEVEL=info
