# ── AIASK 环境变量配置模板 ──
# 复制为 .env 后修改

# PostgreSQL / TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockdb
POSTGRES_PORT=5432
POSTGRES_CONTAINER_MEM_LIMIT=4g
POSTGRES_CONTAINER_SHM_SIZE=2gb
POSTGRES_CONTAINER_CPUS=2.0
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1024MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_AUTOVACUUM_WORK_MEM=64MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=1
POSTGRES_MAX_PARALLEL_WORKERS=2
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=1
POSTGRES_MAX_WORKER_PROCESSES=8
POSTGRES_TIMESCALE_MAX_BACKGROUND_WORKERS=4
POSTGRES_HUGE_PAGES=off

# Redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:redis_secret@127.0.0.1:6379

# Python runtime in Docker
PYTHONWARNINGS=ignore::ResourceWarning
TQDM_DISABLE=1
AKSHARE_MCP_SUPPRESS_RESOURCE_WARNINGS=true

# Docker / images / bind hosts
# Docker Compose v2.40 的 bake 委托在部分本地路径下会触发 BuildKit session header 异常；
# 当前项目默认关闭 bake，使用 Compose 内置 builder 保持 `docker compose build` 可复现。
COMPOSE_BAKE=false
WEB_IMAGE=aiask-web:local
BFF_IMAGE=aiask-bff:local
AKSHARE_MCP_IMAGE=aiask-akshare-mcp:local
STRATEGY_FACTORY_WORKER_IMAGE=aiask-strategy-factory-worker:local
WEB_BIND_HOST=0.0.0.0
BFF_BIND_HOST=0.0.0.0

# MCP Server
MCP_PORT=3100
MCP_BIND_HOST=127.0.0.1
MCP_TRANSPORT=streamable-http
MCP_STREAMABLE_HTTP_URL=http://127.0.0.1:3100/mcp
MCP_STREAMABLE_HTTP_HEADERS={"authorization":"Bearer local-dev-mcp-token"}
MCP_STREAMABLE_HTTP_ALLOW_SSE_FALLBACK=false
MCP_TRANSPORT_ALLOW_STDIO_FALLBACK=false
MCP_HOST=127.0.0.1
MCP_PUBLIC_HOST=127.0.0.1
MCP_PUBLIC_PORT=3100
MCP_ALLOWED_HOSTS=127.0.0.1:3100,localhost:3100,akshare-mcp:3100
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MCP_AUTH_MODE=bearer
MCP_AUTH_TOKEN=local-dev-mcp-token
MCP_ALLOW_TOKEN_PASSTHROUGH=false
MCP_STREAMABLE_HTTP_TIMEOUT_MS=5000
MCP_POOL_ACQUIRE_TIMEOUT_MS=1500
MCP_TOOL_TIMEOUT_MS=8000
MCP_WAIT_QUEUE_LIMIT=32
MCP_HEALTH_CACHE_TTL_MS=10000
MCP_HEALTH_STALE_IF_ERROR_MS=120000
MCP_METRICS_WINDOW_SIZE=120
MCP_DEDICATED_TOOLS=
MCP_TOOL_TIMEOUT_OVERRIDES=strategy_manager:5000,paper_trading_manager:4000,list_skills:2500,get_kline:30000,get_kline_data:30000
MCP_TOOL_CIRCUIT_BREAKER_FAILURES=2
MCP_TOOL_CIRCUIT_BREAKER_MS=10000
BFF_HEALTH_PROBE_TIMEOUT_MS=4000
MCP_POOL_SIZE=4
AKSHARE_MCP_DB_POOL_MIN=1
AKSHARE_MCP_DB_POOL_MAX=2
AKSHARE_MCP_STARTUP_PROFILE=worker
MCP_STDIO_STARTUP_PROFILE=worker
STRATEGY_FACTORY_ASYNC_WORKER_ENABLED=true
STRATEGY_FACTORY_STATUS_SOURCE=db
STRATEGY_FACTORY_WORKER_POLL_INTERVAL_SECONDS=2
STRATEGY_FACTORY_WORKER_SYNC_FACTORY_DISPATCH=true

# BFF Server
BFF_PORT=3001
BFF_NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://web:3000
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aiask-bff
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
APP_JWT_SECRET=local-dev-jwt-secret-change-me-32chars
APP_ADMIN_PASSWORD=local-admin-password
# development Docker 默认将持久化 DB 中的 admin 密码同步为 APP_ADMIN_PASSWORD；
# 生产环境可设为 if-default 或 never，避免覆盖人工改过的密码。
APP_ADMIN_PASSWORD_SYNC=if-mismatch
APP_ENABLE_DEMO_USER=true
APP_DEMO_PASSWORD=demo123
APP_ENCRYPT_SECRET=local-dev-encrypt-secret-32chars
APP_COOKIE_SECURE=false
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/stockdb
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX_USES=0
DATABASE_POOL_APP_NAME=aiask-bff
CACHE_MEMORY_MAX_ENTRIES=5000
CACHE_TTL_DEFAULT_SECONDS=0
CACHE_TTL_OVERRIDES={}
HTTP_THROTTLE_TTL_MS=60000
HTTP_THROTTLE_LIMIT=600
MARKET_SCHEDULER_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Web Frontend
WEB_PORT=3000
WEB_INTERNAL_BFF_BASE_URL=http://bff:3001/api
WEB_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_BFF_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Monitoring
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
OTEL_HEALTH_PORT=13133
POSTGRES_EXPORTER_PORT=9187
BLACKBOX_EXPORTER_PORT=9115

# Sentry (可选)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# 日志级别
LOG_LEVEL=info

# Embedding 默认值
STRATEGY_EMBEDDING_ENABLED=1
STRATEGY_EMBEDDING_PROVIDER=hash_fallback
STRATEGY_EMBEDDING_BASE_URL=
STRATEGY_EMBEDDING_API_KEY=
STRATEGY_EMBEDDING_MODEL=text-embedding-3-small
STRATEGY_EMBEDDING_ALLOW_HASH_FALLBACK=1
STARTUP_EMBEDDING_CHECK_ENABLED=0
VECTOR_INDEX_BUILD_MAINTENANCE_WORK_MEM=256MB
VECTOR_INDEX_BUILD_MAX_PARALLEL_MAINTENANCE_WORKERS=1

# Strategy Factory
FACTOR_SCHEDULER_LLM_MINING=1
STRATEGY_FACTORY_SCHEDULE_MODE=continuous
STRATEGY_FACTORY_MAX_RESEARCH_TASKS=12
STRATEGY_FACTORY_MAX_BULK_RESEARCH_TASKS=20
STRATEGY_FACTORY_CANDIDATES_PER_TASK=4
STRATEGY_FACTORY_TASK_HARD_CAP=24
STRATEGY_FACTORY_RESEARCH_TASK_CONCURRENCY=5
STRATEGY_FACTORY_PRE_GATE_ENABLED=true
STRATEGY_FACTORY_SPAWNER_TARGET_TOTAL=20
STRATEGY_FACTORY_SPAWNER_FILL_BUDGET_MAX=10
STRATEGY_FACTORY_SPAWNER_EVENT_FILL_BUDGET_MAX=3
STRATEGY_FACTORY_SPAWNER_EVENT_SOURCE_BASE_CAP=1
STRATEGY_FACTORY_SPAWNER_EVENT_SOURCE_SUPPLEMENTAL_BONUS=1
STRATEGY_FACTORY_BULK_STOCK_MATRIX_ENABLED=false
STRATEGY_FACTORY_BULK_STOCK_MATRIX_UNIVERSE_LIMIT=5000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_FAMILIES_PER_STOCK=3
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_TASKS_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_CANDIDATES_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_GENERATION_LIMIT_PER_TASK=1
STRATEGY_FACTORY_BULK_BATCH_SIZE=100
STRATEGY_FACTORY_BULK_CONCURRENCY=20
STRATEGY_FACTORY_BULK_STOCK_MATRIX_TASKS_PER_SHARD=24
STRATEGY_FACTORY_FACTOR_AUTO_REFRESH=0
