{
  "name": "@aiask/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && next build",
    "start": "next start -p 3000",
    "lint": "eslint app components lib store hooks e2e --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aiask/shared-types": "*",
    "@sentry/nextjs": "^10.39.0",
    "@tanstack/react-query": "^5.50.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "lightningcss": "^1.31.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
