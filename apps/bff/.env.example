# MCP Gateway（Docker 默认：streamable-http 指向 akshare-mcp 容器）
# 保持与 MCP `listTools()` 实际运行结果同步；当前仓库运行基线为 161。
MCP_TRANSPORT=streamable-http
MCP_STREAMABLE_HTTP_URL=http://127.0.0.1:3100/mcp
MCP_STREAMABLE_HTTP_HEADERS={"authorization":"Bearer local-dev-mcp-token"}
MCP_STREAMABLE_HTTP_ALLOW_SSE_FALLBACK=false
MCP_TRANSPORT_ALLOW_STDIO_FALLBACK=false
MCP_STREAMABLE_HTTP_TIMEOUT_MS=2500
MCP_EXPECTED_TOOLS=161

# stdio 仅作为本地调试备用路径
MCP_STDIO_COMMAND=python
MCP_STDIO_ARGS=["-m","akshare_mcp.server"]
# 默认自动推断到仓库 packages/akshare-mcp；如目录结构变化可手工指定
MCP_STDIO_CWD=
# 默认自动推断为 {MCP_STDIO_CWD}/src
MCP_STDIO_PYTHONPATH=
MCP_STDIO_PYTHONIOENCODING=utf-8

# MCP 连接池与超时配置
MCP_POOL_SIZE=4
MCP_POOL_ACQUIRE_TIMEOUT_MS=1500
MCP_WAIT_QUEUE_LIMIT=32
MCP_TOOL_TIMEOUT_MS=8000
MCP_HEALTH_CACHE_TTL_MS=10000
MCP_HEALTH_STALE_IF_ERROR_MS=120000
MCP_METRICS_WINDOW_SIZE=120
MCP_DEDICATED_TOOLS=
MCP_TOOL_TIMEOUT_OVERRIDES=strategy_manager:5000,paper_trading_manager:4000,list_skills:2500,get_kline:8000,get_kline_data:8000
MCP_TOOL_CIRCUIT_BREAKER_MS=10000
BFF_HEALTH_PROBE_TIMEOUT_MS=1500
AKSHARE_MCP_DB_POOL_MIN=1
AKSHARE_MCP_DB_POOL_MAX=2
# MCP 子进程启动模式: full | worker | balanced | tool-only
# BFF 默认使用 worker：完整工具注册，但不启动 MCP 自治后台调度器。
MCP_STDIO_STARTUP_PROFILE=worker

# 服务端口
BFF_PORT=3001

# 认证配置
APP_JWT_SECRET=replace_me
APP_ACCESS_TOKEN_TTL_SECONDS=7200
APP_REFRESH_TOKEN_TTL_SECONDS=604800
APP_ADMIN_PASSWORD=admin123
# never | if-default | if-mismatch；开发 Docker 推荐 if-mismatch 以避免持久化卷密码漂移。
APP_ADMIN_PASSWORD_SYNC=if-mismatch

# 数据库/缓存
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX_USES=0
DATABASE_POOL_APP_NAME=aiask-bff
CACHE_MEMORY_MAX_ENTRIES=5000
CACHE_TTL_DEFAULT_SECONDS=0
CACHE_TTL_OVERRIDES={}

# HTTP / 后台调度
HTTP_THROTTLE_TTL_MS=60000
HTTP_THROTTLE_LIMIT=600
MARKET_SCHEDULER_ENABLED=false

# 安全
APP_ENCRYPT_SECRET=replace-with-32-char-secret-key!
SENTRY_DSN=

# 策略市场时区 (默认 Asia/Shanghai)
STRATEGY_MARKET_TIMEZONE=Asia/Shanghai
STRATEGY_FACTORY_STATUS_SOURCE=db
STRATEGY_FACTORY_STATUS_WARMUP_DELAY_MS=20000
STRATEGY_FACTORY_RUN_TIMEOUT_MS=240000
SKILL_RUN_TIMEOUT_MS=120000

# 通知 webhook（默认关闭）
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
