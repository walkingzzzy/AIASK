# MCP Gateway（推荐：连接 Docker 常驻 streamable-http MCP）
# 保持与 MCP `listTools()` 实际运行结果同步；当前仓库运行基线为 161。
MCP_EXPECTED_TOOLS=161
MCP_TRANSPORT=streamable-http
MCP_STREAMABLE_HTTP_URL=http://127.0.0.1:3100/mcp
MCP_STREAMABLE_HTTP_HEADERS={"authorization":"Bearer change_me_mcp_token"}
MCP_STREAMABLE_HTTP_ALLOW_SSE_FALLBACK=false
MCP_TRANSPORT_ALLOW_STDIO_FALLBACK=false

# stdio fallback 仅用于本地排障；默认关闭，避免 BFF 重复拉起 Python MCP 子进程。
MCP_STDIO_COMMAND=python
MCP_STDIO_ARGS=["-m","akshare_mcp.server"]
# 默认自动推断到仓库 packages/akshare-mcp；如目录结构变化可手工指定
MCP_STDIO_CWD=
# 默认自动推断为 {MCP_STDIO_CWD}/src
MCP_STDIO_PYTHONPATH=
MCP_STDIO_PYTHONIOENCODING=utf-8

# MCP 连接池与超时配置
MCP_POOL_SIZE=4
MCP_POOL_ACQUIRE_TIMEOUT_MS=1500
MCP_TOOL_TIMEOUT_MS=30000
BFF_HEALTH_PROBE_TIMEOUT_MS=1500
AKSHARE_MCP_DB_POOL_MIN=1
AKSHARE_MCP_DB_POOL_MAX=2
# MCP 子进程启动模式: full | worker | balanced | tool-only
# BFF 默认使用 worker：完整工具注册，但不启动 MCP 自治后台调度器。
MCP_STDIO_STARTUP_PROFILE=worker
MARKET_INDEX_FAILURE_BACKOFF_MS=30000
MARKET_INDEX_FAILURE_MAX_BACKOFF_MS=120000

# 服务端口
BFF_PORT=3001

# 认证配置
APP_JWT_SECRET=replace_me
APP_ACCESS_TOKEN_TTL_SECONDS=7200
APP_REFRESH_TOKEN_TTL_SECONDS=604800
APP_ADMIN_PASSWORD=admin123

# 数据库/缓存
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# 安全
APP_ENCRYPT_SECRET=replace-with-32-char-secret-key!
SENTRY_DSN=

# 策略市场时区 (默认 Asia/Shanghai)
STRATEGY_MARKET_TIMEZONE=Asia/Shanghai
STRATEGY_FACTORY_RUN_TIMEOUT_MS=240000
SKILL_RUN_TIMEOUT_MS=120000
