{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIASK Desktop",
  "version": "0.1.0",
  "identifier": "com.aiask.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIASK Desktop",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  }
}
