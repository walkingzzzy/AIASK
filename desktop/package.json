{
  "name": "aiask-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test",
    "test:e2e:live": "AIASK_DESKTOP_RUN_LIVE=1 playwright test --grep \"optional live desktop smoke\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^29.1.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
