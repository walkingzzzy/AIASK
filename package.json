{
  "name": "aiask-app-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:all": "node scripts/dev-all.mjs",
    "dev:bff": "npm run dev -w apps/bff",
    "dev:web": "npm run dev -w apps/web",
    "docker:build": "COMPOSE_BAKE=false docker compose build",
    "docker:up": "COMPOSE_BAKE=false docker compose up -d --build",
    "docker:down": "docker compose down",
    "monitoring:up": "docker compose --profile monitoring up -d otel-collector postgres-exporter blackbox-exporter alertmanager prometheus",
    "monitoring:down": "docker compose --profile monitoring down",
    "build": "npm run build -w packages/shared-types && npm run build -w apps/bff && npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:monitoring": "node scripts/monitoring-smoke.mjs",
    "verify:production-gap-readiness": "node scripts/production-gap-readiness.mjs --with-tests",
    "verify:execution-audit-acceptance": "python scripts/strategy-execution-audit-acceptance.py --statuses submitted,listed,incubating,rejected --selection-mode runtime_evidence --limit 20 --backfill --fail-on-blockers",
    "replay:incubation-history-samples": "python scripts/strategy-incubation-history-replay.py",
    "verify:ws-quote-chain": "npm run build -w apps/bff && npm run build -w apps/web && node scripts/ws-quote-chain-check.mjs",
  "verify:responsive-ui": "node scripts/playwright-mcp-audit/build-manifest.mjs --output-dir artifacts/responsive-audit && node scripts/playwright-mcp-audit/run-responsive-audit.mjs --output-dir artifacts/responsive-audit",
  "verify:state-smoke": "node scripts/playwright-mcp-audit/run-state-smoke.mjs --output-dir artifacts/state-smoke",
    "audit:frontend-e2e": "node scripts/playwright-mcp-audit/run-platform-audit.mjs --output-dir artifacts/frontend-e2e-audit --enforce",
    "audit:frontend-report": "node scripts/playwright-mcp-audit/run-frontend-audit.mjs --output-dir frontend-audit-report",
    "verify:frontend-platform": "npm run typecheck -w apps/web && npm run typecheck -w apps/bff && npm run build -w apps/web && npm run build -w apps/bff && npm run test:contracts -w apps/bff && npm run audit:frontend-e2e",
    "verify:security-boundaries": "npm run build -w apps/bff && node scripts/security-boundary-check.mjs",
    "verify:mcp-arg-boundaries": "npm run build -w apps/bff && node scripts/mcp-arg-boundary-check.mjs",
    "start:bff": "npm run start -w apps/bff",
    "start:web": "npm run start -w apps/web",
    "lint": "eslint apps/web/app apps/web/components apps/web/lib apps/web/store apps/web/hooks apps/bff/src",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1"
  },
  "dependencies": {}
}
