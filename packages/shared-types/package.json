  "scripts": {
    "build": "node ../../scripts/generate-strategy-contracts.mjs && tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/generate-strategy-contracts.mjs && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
