{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akshare-mcp.local/schemas/factor_candidate.schema.json",
  "title": "FactorGenerationEnvelope",
  "type": "object",
  "required": [
    "candidates"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/FactorCandidate"
      }
    },
    "analysis": {
      "type": "object",
      "default": {}
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "additionalProperties": true,
  "$defs": {
    "FactorCandidate": {
      "type": "object",
      "required": [
        "name",
        "hypothesis",
        "family",
        "inputs",
        "expression_dsl",
        "expected_holding_period"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "hypothesis": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400
        },
        "family": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "string"
          }
        },
        "expression_dsl": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "expected_holding_period": {
          "type": "integer",
          "minimum": 1,
          "maximum": 252
        },
        "expected_regime": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "default": []
        },
        "complexity_hint": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        "novelty_rationale": {
          "type": "string",
          "maxLength": 400,
          "default": ""
        },
        "generation_trace": {
          "type": "object",
          "default": {}
        },
        "source_model": {
          "type": "string",
          "maxLength": 120,
          "default": ""
        }
      },
      "additionalProperties": true
    }
  }
