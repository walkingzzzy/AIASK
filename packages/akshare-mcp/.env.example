# TimescaleDB配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=password
DB_CONNECT_TIMEOUT_MS=10000

# AKShare配置
AKSHARE_SPOT_TTL_SECONDS=2
AKSHARE_SPOT_TIMEOUT_SECONDS=15

# Tushare Pro Token（不要提交真实值到仓库）
TUSHARE_TOKEN=your_tushare_token_here
# Tushare API 地址（如使用自建/代理服务）
TUSHARE_HTTP_URL=https://api.tushare.pro
# Tushare 代理可用接口白名单路径（扫描脚本自动写入）
TUSHARE_WHITELIST_PATH=src/akshare_mcp/config/tushare_proxy_whitelist.json

# 策略外部 AI 生成配置（OpenAI-compatible）
STRATEGY_LLM_ENABLED=0
STRATEGY_LLM_PROVIDER=openai_compatible
STRATEGY_LLM_BASE_URL=https://api.openai.com/v1
STRATEGY_LLM_API_KEY=
STRATEGY_LLM_MODEL=gpt-4.1-mini
STRATEGY_LLM_TIMEOUT_SEC=30

# 因子研究外部 AI 配置（未显式填写时会回退到 STRATEGY_LLM_*）
FACTOR_LLM_ENABLED=0
FACTOR_LLM_PROVIDER=
FACTOR_LLM_BASE_URL=
FACTOR_LLM_API_KEY=
FACTOR_LLM_MODEL=
FACTOR_LLM_TIMEOUT_SEC=30
FACTOR_LLM_TEMPERATURE=0.2
FACTOR_LLM_RETRY_COUNT=2
FACTOR_LLM_RETRY_BACKOFF_SEC=1.0
FACTOR_LLM_STRICT_MODE=0

# 文本向量 embedding（默认复用 STRATEGY_LLM 的 base_url/api_key）
STRATEGY_EMBEDDING_ENABLED=0
STRATEGY_EMBEDDING_PROVIDER=openai_compatible
STRATEGY_EMBEDDING_BASE_URL=${STRATEGY_LLM_BASE_URL}
STRATEGY_EMBEDDING_API_KEY=${STRATEGY_LLM_API_KEY}
STRATEGY_EMBEDDING_MODEL=text-embedding-3-small
STRATEGY_EMBEDDING_TIMEOUT_SEC=20
STRATEGY_EMBEDDING_MAX_TEXT_CHARS=6000
STRATEGY_LLM_TEMPERATURE=0.3
STRATEGY_LLM_RETRY_COUNT=2
STRATEGY_LLM_RETRY_BACKOFF_SEC=1.0
STRATEGY_LLM_INITIAL_COMPACT_LEVEL=0
STRATEGY_LLM_RECENT_TIMEOUT_MINIMAL_STREAK=1
STRATEGY_LLM_RECENT_TIMEOUT_COOLDOWN_SEC=600
# 设为 1 时，外部 AI 调用失败不回退本地生成
STRATEGY_LLM_STRICT_MODE=0

# 策略工厂调度模式
# continuous = 24/7 循环运行（盘中15分钟、盘后60分钟间隔）
# daily = 每日定时运行一次（向后兼容模式）
STRATEGY_FACTORY_SCHEDULE_MODE=continuous
# A股盘中 (工作日 9:30-15:00) 循环间隔，单位秒（默认 900 = 15分钟）
STRATEGY_FACTORY_MARKET_HOURS_INTERVAL_SEC=900
# 盘后/周末循环间隔，单位秒（默认 3600 = 60分钟）
STRATEGY_FACTORY_OFF_HOURS_INTERVAL_SEC=3600
# 每日最大运行次数安全上限（默认 48）
STRATEGY_FACTORY_MAX_DAILY_RUNS=48
# 出错后等待秒数（默认 120）
STRATEGY_FACTORY_ERROR_BACKOFF_SEC=120
# 仅 daily 模式：每日运行时间，格式 HH:MM（默认 19:00）
STRATEGY_FACTORY_DAILY_RUN_TIME=19:00
