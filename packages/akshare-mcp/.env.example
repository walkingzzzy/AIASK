# TimescaleDB配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=password
DB_CONNECT_TIMEOUT_MS=10000

# AKShare配置
AKSHARE_SPOT_TTL_SECONDS=2
AKSHARE_SPOT_TIMEOUT_SECONDS=15

# Tushare Pro Token（不要提交真实值到仓库）
TUSHARE_TOKEN=your_tushare_token_here
# Tushare API 地址（如使用自建/代理服务）
TUSHARE_HTTP_URL=http://api.tushare.pro
# Tushare 代理可用接口白名单路径（扫描脚本自动写入）
TUSHARE_WHITELIST_PATH=src/akshare_mcp/config/tushare_proxy_whitelist.json

# 策略外部 AI 生成配置（OpenAI-compatible）
STRATEGY_LLM_ENABLED=0
STRATEGY_LLM_PROVIDER=openai_compatible
STRATEGY_LLM_BASE_URL=https://api.openai.com/v1
STRATEGY_LLM_API_KEY=
STRATEGY_LLM_MODEL=gpt-4.1-mini
STRATEGY_LLM_TIMEOUT_SEC=30

# 因子研究外部 AI 配置（未显式填写时会回退到 STRATEGY_LLM_*）
FACTOR_LLM_ENABLED=0
FACTOR_SCHEDULER_LLM_MINING=1
FACTOR_LLM_PROVIDER=
FACTOR_LLM_BASE_URL=
FACTOR_LLM_API_KEY=
FACTOR_LLM_MODEL=
FACTOR_LLM_TIMEOUT_SEC=30
FACTOR_LLM_TEMPERATURE=0.2
FACTOR_LLM_RETRY_COUNT=2
FACTOR_LLM_RETRY_BACKOFF_SEC=1.0
FACTOR_LLM_STRICT_MODE=0

# 文本向量 embedding（默认退回本地 hash_fallback；需要远程 provider 时再切回 openai_compatible）
STRATEGY_EMBEDDING_ENABLED=1
STRATEGY_EMBEDDING_PROVIDER=hash_fallback
STRATEGY_EMBEDDING_BASE_URL=
STRATEGY_EMBEDDING_API_KEY=
STRATEGY_EMBEDDING_MODEL=text-embedding-3-small
STRATEGY_EMBEDDING_ALLOW_HASH_FALLBACK=1
STRATEGY_EMBEDDING_RETRY_COUNT=2
STRATEGY_EMBEDDING_RETRY_BACKOFF_SEC=0.75
STRATEGY_EMBEDDING_SMOKE_CHECK_ENABLED=1
STRATEGY_EMBEDDING_SMOKE_CHECK_TTL_SEC=300
STRATEGY_EMBEDDING_TIMEOUT_SEC=20
STRATEGY_EMBEDDING_MAX_TEXT_CHARS=6000
STARTUP_EMBEDDING_CHECK_ENABLED=0
STARTUP_EMBEDDING_CHECK_FORCE=1
STRATEGY_LLM_TEMPERATURE=0.3
STRATEGY_LLM_RETRY_COUNT=2
STRATEGY_LLM_RETRY_BACKOFF_SEC=1.0
STRATEGY_LLM_INITIAL_COMPACT_LEVEL=0
STRATEGY_LLM_RECENT_TIMEOUT_MINIMAL_STREAK=1
STRATEGY_LLM_RECENT_TIMEOUT_COOLDOWN_SEC=600
# 设为 1 时，外部 AI 调用失败不回退本地生成
STRATEGY_LLM_STRICT_MODE=0

# 策略工厂调度模式
# continuous = 24/7 循环运行（盘中15分钟、盘后60分钟间隔）
# daily = 每日定时运行一次（向后兼容模式）
STRATEGY_FACTORY_SCHEDULE_MODE=continuous
# A股盘中 (工作日 9:30-15:00) 循环间隔，单位秒（默认 900 = 15分钟）
STRATEGY_FACTORY_MARKET_HOURS_INTERVAL_SEC=900
# 盘后/周末循环间隔，单位秒（默认 3600 = 60分钟）
STRATEGY_FACTORY_OFF_HOURS_INTERVAL_SEC=3600
# 每日最大运行次数安全上限（默认 48）
STRATEGY_FACTORY_MAX_DAILY_RUNS=48
# 出错后等待秒数（默认 120）
STRATEGY_FACTORY_ERROR_BACKOFF_SEC=120
STRATEGY_FACTORY_FACTOR_AUTO_REFRESH=0
# 仅 daily 模式：每日运行时间，格式 HH:MM（默认 19:00）
STRATEGY_FACTORY_DAILY_RUN_TIME=19:00

# 策略工厂 P0：Bulk Stock Matrix / Pre-Gate
# 逐股多 family 批量生成入口，建议先在小流量环境开启并观察 DB / K 线缓存命中率
STRATEGY_FACTORY_MAX_RESEARCH_TASKS=12
STRATEGY_FACTORY_MAX_BULK_RESEARCH_TASKS=20
STRATEGY_FACTORY_BULK_STOCK_MATRIX_ENABLED=0
STRATEGY_FACTORY_BULK_STOCK_MATRIX_UNIVERSE_LIMIT=5000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_FAMILIES_PER_STOCK=3
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_TASKS_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_MAX_CANDIDATES_PER_RUN=15000
STRATEGY_FACTORY_BULK_STOCK_MATRIX_GENERATION_LIMIT_PER_TASK=1
STRATEGY_FACTORY_BULK_BATCH_SIZE=100
STRATEGY_FACTORY_BULK_CONCURRENCY=20
STRATEGY_FACTORY_BULK_STOCK_MATRIX_TASKS_PER_SHARD=24
STRATEGY_FACTORY_PRE_GATE_ENABLED=1

# 启动预热：建议与 Bulk Lane 一起开启，优先预热 core_market / factor_context
STRATEGY_FACTORY_STARTUP_WARMUP_ENABLED=1
STRATEGY_FACTORY_STARTUP_WARMUP_FORCE=0
STRATEGY_FACTORY_STARTUP_WARMUP_LIMIT=4
STRATEGY_FACTORY_STARTUP_WARMUP_TASK_TYPE=core_market,factor_context

# MCP HTTP / SSE 传输安全配置
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ALLOWED_ORIGINS=http://localhost:3000
MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
MCP_AUTH_MODE=bearer
MCP_AUTH_TOKEN=
MCP_AUTH_CLIENT_ID=default
MCP_AUTH_REQUIRED_SCOPES=mcp
MCP_AUTH_DEFAULT_SCOPES=mcp
MCP_PUBLIC_SCHEME=http
MCP_PUBLIC_HOST=127.0.0.1
MCP_PUBLIC_PORT=8000

# 高风险操作门禁与审计
AKSHARE_REQUIRE_CONFIRMATION=0
AKSHARE_CONFIRM_TOKEN=
AKSHARE_AUDIT_LOG=logs/risk_audit.jsonl

# user_manager 跨用户访问仅允许在显式内部调用时开启
AKSHARE_USER_MANAGER_ALLOW_IMPERSONATION=0
